docs/.vitepress/dist/
docs/.vitepress/cache/
docs/node_modules/
docs/superpowers/

# Playwright MCP logs
.playwright-mcp/

# Admin local env files
admin/.env.development
admin/.env.production

# Docker environment
.env
.env.*
!.env.example

# Local dev screenshots
*.png
*.jpg
*.jpeg

# Allow client public placeholder assets
#
# The blanket *.png above is aimed at screenshots dropped in the working tree, but it also
# swallowed the storefront icons: apple-touch-icon.png and both android-chrome sizes were
# generated, ignored, and never committed, so nuxt.config and the web manifest advertised
# three files that answered 404 on every deployment including production. Anything directly
# in client/public is a served asset, not a screenshot -- whitelist the folder rather than
# naming files one at a time and losing the next one the same way.
# The admin panel needs the same exemption for the same reason: it ships the identical
# eight-file icon set, and the first pass here whitelisted only the storefront, so the
# panel's six PNGs were staged, silently dropped, and committed as an .ico and a manifest
# pointing at files that were not there.
!client/public/*.png
# og-image.jpg is the default share card nuxt.config, useSeo and the product pages point at.
!client/public/*.jpg
!admin/public/*.png
!client/public/images/**
# Screenshots committed under docs/ are tracked assets, not local dev dumps.
!docs/**/*.png

# IDEs
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.code-workspace
.vs/

# Junk folders
undefined/
whmcs_dump.sql

# Pre-deploy database dumps. deploy:prod writes them into the checkout it deploys
# from, so they sit inside the working tree and would otherwise show as untracked
# on every production host.
backups/

# Operator-uploaded branding: written into the API web root at runtime and backed by a
# named volume in production. The directory itself is committed (wwwroot must exist before
# UseStaticFiles resolves its provider at startup); its contents belong to the deployment,
# never to the repository.
backend/src/Innovayse.Hostpanel.API/wwwroot/uploads/

# Playwright output
client/test-results/
client/playwright-report/
client/e2e-results.xml

# Generated by install.sh for the host-nginx install
docker/docker-compose.host-proxy.yml

# Message handler code generated at image build time (backend/Dockerfile, codegen write)
backend/src/Innovayse.Hostpanel.API/Internal/Generated/
