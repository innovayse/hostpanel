# hostpanel: formatting and analyzer settings for every file in this project.
#
# Everything here is enforced: dotnet build runs the analyzers (EnforceCodeStyleInBuild in
# Directory.Build.props), dotnet format --verify-no-changes runs in CI, and the frontend's ESLint
# reads the same indentation. A rule marked :error fails the build, not the review.
root = true

[*]
charset = utf-8
indent_style = space
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{cs,csx}]
indent_size = 4

# ── Documentation — every member, every project (see rules/documentation.md) ─────────────
# CS1591 covers public members; SA1600 below (documentPrivateElements in stylecop.json) covers the rest.
dotnet_diagnostic.CS1591.severity = error

# ── Braces on every block (see rules/code-style.md) ──────────────────────────────────────
csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_block_contents = true
csharp_indent_braces = false

# ── StyleCop: only documentation and braces are on; everything else stays silent ─────────
dotnet_diagnostic.SA1600.severity = error   # elements should be documented (private too, per stylecop.json)
dotnet_diagnostic.SA1601.severity = error   # partial elements should be documented
dotnet_diagnostic.SA1602.severity = error   # enumeration items should be documented
dotnet_diagnostic.SA1611.severity = error   # element parameters should be documented
dotnet_diagnostic.SA1615.severity = error   # element return value should be documented
dotnet_diagnostic.SA1618.severity = error   # generic type parameters should be documented
dotnet_diagnostic.SA1503.severity = error   # braces should not be omitted
dotnet_diagnostic.SA1633.severity = none    # no file headers
dotnet_diagnostic.SA1649.severity = none    # a generic Name<T> lives in NameOfT.cs beside Name.cs (rules/file-layout.md); StyleCop wants Name{T}.cs
dotnet_diagnostic.SA1636.severity = none    # no copyright header text to match either (fires on GlobalUsings.cs's leading // comment)
dotnet_diagnostic.SA1200.severity = none    # using placement is .editorconfig's business
dotnet_diagnostic.SA1101.severity = none    # no `this.` prefix requirement
dotnet_diagnostic.SA1309.severity = none    # underscore-prefixed private fields are our convention
dotnet_diagnostic.SA1413.severity = none    # trailing commas are free
dotnet_diagnostic.SA1000.severity = none
dotnet_diagnostic.SA1009.severity = none
dotnet_diagnostic.SA1028.severity = none
dotnet_diagnostic.SA1116.severity = none
dotnet_diagnostic.SA1117.severity = none
dotnet_diagnostic.SA1118.severity = none
dotnet_diagnostic.SA1122.severity = none
dotnet_diagnostic.SA1127.severity = none
dotnet_diagnostic.SA1128.severity = none
dotnet_diagnostic.SA1201.severity = none
dotnet_diagnostic.SA1202.severity = none
dotnet_diagnostic.SA1203.severity = none
dotnet_diagnostic.SA1204.severity = none
dotnet_diagnostic.SA1214.severity = none
dotnet_diagnostic.SA1402.severity = none    # one type per file is FolderNameTests/UseCaseShapeTests' business, with better messages
dotnet_diagnostic.SA1502.severity = none
dotnet_diagnostic.SA1512.severity = none
dotnet_diagnostic.SA1513.severity = none
dotnet_diagnostic.SA1515.severity = none
dotnet_diagnostic.SA1516.severity = none
dotnet_diagnostic.SA1518.severity = none
dotnet_diagnostic.SA1623.severity = none    # "Gets or sets" wording is not required
dotnet_diagnostic.SA1629.severity = none    # trailing period in summaries is not required
dotnet_diagnostic.SA1642.severity = none
dotnet_diagnostic.SA1643.severity = none
dotnet_diagnostic.SA0001.severity = none

# ── Namespaces and usings ─────────────────────────────────────────────────────────────────
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0161.severity = error
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0005.severity = error   # unused using

# ── Style the reviewer would otherwise repeat ─────────────────────────────────────────────
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_collection_expression = true:suggestion
dotnet_style_readonly_field = true:error
dotnet_style_require_accessibility_modifiers = always:error
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
dotnet_diagnostic.CA2007.severity = none      # ConfigureAwait is not used in ASP.NET Core apps
dotnet_diagnostic.CA1848.severity = none      # LoggerMessage delegates: not required here
dotnet_diagnostic.CA1062.severity = none      # nullable reference types replace null checks

# ── Naming ────────────────────────────────────────────────────────────────────────────────
# Constants and static readonly fields are PascalCase, as in the house code (SerializerOptions);
# these rules carry required modifiers, so they outrank the plain private-field rule below.
dotnet_naming_rule.constant_fields_pascal.symbols = constant_fields
dotnet_naming_rule.constant_fields_pascal.style = pascal_case_style
dotnet_naming_rule.constant_fields_pascal.severity = error
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields.required_modifiers = const

dotnet_naming_rule.static_readonly_fields_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_pascal.style = pascal_case_style
dotnet_naming_rule.static_readonly_fields_pascal.severity = error
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = error
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.async_methods_suffix.symbols = async_methods
dotnet_naming_rule.async_methods_suffix.style = async_suffix
# A suggestion, not an error: Wolverine handlers must be named Handle, controller actions take the
# route's name, and tests use Method_Scenario_Expectation — none of them carry the suffix.
dotnet_naming_rule.async_methods_suffix.severity = suggestion
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.async_suffix.capitalization = pascal_case
dotnet_naming_style.async_suffix.required_suffix = Async

# CA1716 flags names that collide with a keyword in another .NET language. Two of ours do, and
# both are named the way the house rules require rather than by accident:
#
#   * the type `Error` — rules/file-layout.md Part 4 mandates `Result` and `Error` in
#     Domain/Common as the product-wide error mechanism. Renaming it here would leave this
#     product the only one spelling the shared vocabulary differently.
#   * the parameters `from` / `to` on a date range — the pair reads as a range, and `fromDate` /
#     `toDate` would be noise on a method whose two arguments are already DateOnly.
#
# So NamedType and Parameter are left out of the check. Methods, properties and events still
# count, which is where a genuine accidental collision would show up. This codebase is C#-only;
# nothing consumes it from VB.
dotnet_code_quality.CA1716.analyzed_symbol_kinds = Method, Property, Event

# CA1000 (no static members on generic types) is the Result pattern's whole shape:
# `Result<T>.Success(value)` and `Result<T>.Failure(error)` are the only way to construct one,
# because the constructor is private so the success flag and the error cannot disagree. The
# analyzer's concern — a caller having to spell out the type argument — is exactly what we want
# at a call site that is deciding what the result *is*.
dotnet_diagnostic.CA1000.severity = none

# ── Test projects: rules/testing.md names tests Method_Scenario_Expectation ───────────────
# The glob is not anchored at backend/ because the SDK container mounts this file at / and the
# backend at /src, so an anchored path would never match there.
[**/tests/**.cs]
dotnet_diagnostic.CA1707.severity = none   # underscores in identifiers are the test naming convention

# ── EF Core migrations: generated by `dotnet ef`, exempt from the documentation rule ───────
[**/Common/Errors/HostpanelErrorCodes.cs]
dotnet_diagnostic.SA1310.severity = none    # the error codes are UPPER_SNAKE_CASE by contract: they are the wire value clients branch on

[**/Migrations/**.cs]
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.CS1591.severity = none
generated_code = true

[*.{ts,tsx,js,vue,json,yml,yaml,md,html,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sql,lua}]
indent_size = 2

[Makefile]
indent_style = tab
