<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <HostpanelSdkProject>$(MSBuildProjectDirectory.Replace('\', '/').Contains('/Hostpanel.Sdk'))</HostpanelSdkProject>
    <EnforceCodeStyleInBuild Condition="!$(HostpanelSdkProject)">true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    External sign-on support is optional at build time.

    Innovayse.Auth (the external sign-on package behind AUTH_MODE=sso) lives in a private package
    registry. A plain clone of this repository has no credential for it, and before this
    switch existed the API could not even be restored from one: every outside contributor
    stopped at NU1301 401 (Unauthorized).

    The switch follows the credential by default. With NuGetPackageSourceCredentials_innovayse
    set (CI and deployments that use the private package feed) the package is referenced and INNOVAYSE_SSO is
    defined, exactly as before. Without it the build is the standalone one: AUTH_MODE=local
    only, nothing private restored. Either side can be forced with -p:InnovayseSso=true|false.

    A standalone build started with AUTH_MODE=sso refuses to boot with a message naming this
    property, rather than failing later on a scheme that was never registered.
  -->
  <PropertyGroup Condition="'$(InnovayseSso)' == ''">
    <InnovayseSso Condition="'$(NuGetPackageSourceCredentials_innovayse)' != ''">true</InnovayseSso>
    <InnovayseSso Condition="'$(NuGetPackageSourceCredentials_innovayse)' == ''">false</InnovayseSso>
  </PropertyGroup>
  <PropertyGroup Condition="'$(InnovayseSso)' == 'true'">
    <DefineConstants>$(DefineConstants);INNOVAYSE_SSO</DefineConstants>
  </PropertyGroup>

  <!--
    The style rules of .editorconfig run in the build: StyleCop.Analyzers brings the SA rules, and
    EnforceCodeStyleInBuild turns the IDE rules on. stylecop.json holds the settings the SA rules read.
    The Hostpanel.Sdk submodule keeps its own conventions and is left out.
  -->
  <ItemGroup Condition="!$(HostpanelSdkProject)">
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>
</Project>
