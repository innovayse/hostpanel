<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!--
    Image processing for storefront branding uploads: SkiaSharp, MIT-licensed, with the
    dependency-free Linux native assets so the Alpine (musl) production image needs no apk
    packages for it.

    It replaced SixLabors.ImageSharp. 2.1.x was the last Apache-2.0 line and stopped receiving
    fixes; 2.1.13 has published high-severity advisories with no patched 2.x release, and 3.0
    onwards is the Six Labors Split License, which restricts commercial use above a revenue
    threshold. This repository is public and AGPL-3.0-licensed, so a dependency that attaches a
    commercial condition to downstream users is not one this project can take.
  -->
  <ItemGroup>
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>
  <!--
    Invoice PDFs: PDFsharp + MigraDoc, the cross-platform (Core) build. 6.5.0 onwards is
    AGPL-3.0-only, which this AGPL-3.0-licensed project can take; the library refuses to render
    until PdfSharpLicense.SetAgplLicense() is called, which Infrastructure/Pdf/PdfFonts.cs does.
  -->
  <ItemGroup>
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.5.0" />
  </ItemGroup>

  <!-- ASP.NET Core & Identity -->
  <ItemGroup>
    <PackageVersion Include="Innovayse.Auth" Version="3.1.0" />
    <PackageVersion Include="DnsClient" Version="1.8.0" />
    <!--
      9.0.20 rather than the 9.0.1 the other ASP.NET packages here carry: Innovayse.Auth 3.1.0
      declares JwtBearer >= 9.0.20, and central package management turns the resulting
      downgrade into NU1605, which TreatWarningsAsErrors makes a restore failure.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.21" />
    <!-- Keeps the Data Protection key ring in the database (AppDbContext.DataProtectionKeys), so every instance and every redeploy reads the same keys. -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="9.0.21" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.21" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.21" />
    <PackageVersion Include="Stripe.net" Version="51.2.0" />
    <!--
      8.23.0 rather than 8.0.1: Innovayse.Hostpanel.Shared references
      Microsoft.AspNetCore.Authentication.JwtBearer 9.0.21, whose own dependency on
      Microsoft.IdentityModel.Protocols.OpenIdConnect pulls this package to 8.19.2 or later.
      Left at 8.0.1 that is an NU1605 downgrade, which TreatWarningsAsErrors turns into a
      restore failure.
    -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>
  <!-- Entity Framework Core -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.21" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.21" />
    <!-- MigrationBuilder extensions in Shared (Extensions/MigrationBuilderExtensions) need the
         relational-provider abstractions, which the umbrella EntityFrameworkCore package does not carry. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.21" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>
  <!-- Microsoft Extensions -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="9.0.21" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="9.0.21" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="9.0.21" />
    <!--
      Polly's IHttpClientFactory integration, used by the Infrastructure project to put a timeout,
      a circuit breaker and a per-client retry predicate in front of every outbound HTTP client.
      Versioned 9.x rather than 10.x deliberately: the 10.x wave depends on Microsoft.Extensions.*
      10.x, which would drag the whole 9.0.1 set above forward as a side effect of adding
      resilience.
    -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="9.10.0" />
    <!--
      Polly.Core at the version Microsoft.Extensions.Http.Resilience 9.10.0 already resolves, named
      here so the Inecobank plugin can catch the exceptions the resilience handler raises
      (ExecutionRejectedException) and translate them. The plugin runs in the host process and
      shares the host copy of this assembly.
    -->
    <PackageVersion Include="Polly.Core" Version="8.4.2" />
    <!--
      Localization for the error sentences the API sends (Innovayse.Hostpanel.Application/Resources/).
      The abstractions package only: the Application layer declares IStringLocalizer<T> as a
      dependency, while the implementation and AddLocalization() come from the ASP.NET Core
      shared framework the API already targets.
    -->
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="9.0.21" />
    <!--
      The ResourceManager-backed IStringLocalizer implementation. Referenced by
      the test projects only: the API gets it from the ASP.NET Core shared framework,
      but a plain test project has no framework reference to get it from.
    -->
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="9.0.21" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <!--
      9.0.10 rather than 9.0.1, which is the version every other Microsoft.Extensions.*
      package here carries. Microsoft.Extensions.Http.Resilience 9.10.0 raises the
      transitive graph to the 9.0.10 servicing band (EntityFrameworkCore pulls
      Microsoft.Extensions.Logging 9.0.10, which requires Options 9.0.10 or later) while
      the test projects reference Options directly. Left at 9.0.1 that is an
      NU1605 downgrade, which src/Directory.Build.props turns into a build failure.
      Same servicing band, no API change; do not "restore" it to 9.0.1.
    -->
    <PackageVersion Include="Microsoft.Extensions.Options" Version="9.0.21" />
  </ItemGroup>
  <!-- Wolverine -->
  <ItemGroup>
    <PackageVersion Include="WolverineFx" Version="5.41.0" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="5.41.0" />
  </ItemGroup>
  <!-- Application Libraries -->
  <ItemGroup>
    <!--
      FluentValidation 12, not 11. The Shared ValidationPolicy runs this repository's validators on
      the Wolverine bus; the wiring this follows pins 12.* as well.

      FluentValidation.AspNetCore 11.3.0 used to sit on the next line and is gone. It wires MVC
      auto-validation, which this API never called (no type from it appears anywhere in the
      solution), and it has no 12.x release, so keeping it would hold FluentValidation below 12.
    -->
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <!--
      Supplies AddValidatorsFromAssemblyContaining, which Innovayse.Hostpanel.Application's own
      AddApplication (Program.cs split, A6 Task 7B) calls to put the validators in the container
      where the Wolverine middleware looks for them.
    -->
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Fluid.Core" Version="2.40.0" />
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <!--
      Ed25519, which .NET 9 does not ship: it checks the detached signature of a plugin package
      (Infrastructure/Plugins/PluginSignatureVerifier). Already in the closure through MailKit, so this pins the
      version the host resolves anyway, and it is a managed library with no native part.
    -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="Mapster" Version="7.4.0" />
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore.Annotations" Version="6.9.0" />
    <!--
      The client portal keeps its sign-in sessions in Redis, and a back-channel logout deletes them from
      here (Auth/PortalSessionRevoker). 2.8.16 is the version Innovayse.Auth depends on in an SSO build,
      so both builds resolve the same client.
    -->
    <PackageVersion Include="StackExchange.Redis" Version="2.8.16" />
  </ItemGroup>
  <!-- Roslyn / Tooling -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.14.0" />
    <!--
      Transitive pins for advisories NuGet reports through `dotnet list package, vulnerable and
      include-transitive` (the build audit only looks at direct references):
      Microsoft.Build.Tasks.Core arrives at 17.7.2 through Workspaces.MSBuild (design-time only,
      PrivateAssets all; GHSA-h4j7-5rxr-p4wc), and System.Security.Cryptography.Pkcs arrives at 10.0.0
      through MimeKit; System.Security.Cryptography.Xml arrives at 9.0.0 through
      Build.Tasks.Core (GHSA-37gx-xxp4-5rgx, design-time only) (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7; fixed from 10.0.13). Both are
      raised by a direct reference in the project that owns the parent package.
    -->
    <PackageVersion Include="Microsoft.Build.Tasks.Core" Version="17.14.28" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="9.0.21" />
  </ItemGroup>
  <!-- Testing -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Reads rendered invoice PDFs back in the renderer tests. Test-only, Apache-2.0. -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>