<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- ASP.NET Core & Identity -->
  <ItemGroup>
    <PackageVersion Include="Innovayse.Auth" Version="1.0.0" />
    <PackageVersion Include="DnsClient" Version="1.8.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
    <PackageVersion Include="Stripe.net" Version="51.2.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.0.1" />
  </ItemGroup>
  <!-- Entity Framework Core -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.3" />
  </ItemGroup>
  <!-- Microsoft Extensions -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="9.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="9.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="9.0.1" />
    <!--
      Polly's IHttpClientFactory integration, used by Innovayse.Infrastructure to put a timeout,
      a circuit breaker and a per-client retry predicate in front of every outbound HTTP client.
      Versioned 9.x rather than 10.x deliberately: the 10.x wave depends on Microsoft.Extensions.*
      10.x, which would drag the whole 9.0.1 set above forward as a side effect of adding
      resilience.
    -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="9.10.0" />
    <!--
      Localization for the error sentences the API sends (Innovayse.Application/Resources/).
      The abstractions package only: the Application layer declares IStringLocalizer<T> as a
      dependency, while the implementation and AddLocalization() come from the ASP.NET Core
      shared framework the API already targets.
    -->
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="9.0.0" />
    <!--
      The ResourceManager-backed IStringLocalizer implementation. Referenced by
      Innovayse.Application.Tests only: the API gets it from the ASP.NET Core shared framework,
      but a plain test project has no framework reference to get it from.
    -->
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <!--
      9.0.10 rather than 9.0.1, which is the version every other Microsoft.Extensions.*
      package here carries. Microsoft.Extensions.Http.Resilience 9.10.0 raises the
      transitive graph to the 9.0.10 servicing band (EntityFrameworkCore pulls
      Microsoft.Extensions.Logging 9.0.10, which requires Options 9.0.10 or later) while
      Innovayse.Infrastructure.Tests references Options directly. Left at 9.0.1 that is an
      NU1605 downgrade, which src/Directory.Build.props turns into a build failure.
      Same servicing band, no API change; do not "restore" it to 9.0.1.
    -->
    <PackageVersion Include="Microsoft.Extensions.Options" Version="9.0.10" />
  </ItemGroup>
  <!-- Wolverine -->
  <ItemGroup>
    <PackageVersion Include="WolverineFx" Version="5.31.0" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="5.31.0" />
    <!--
      Validation middleware in front of every handler that has a validator. Pinned to the same
      5.31.0 as WolverineFx itself: the two ship together and a mismatch is a startup failure,
      not a compile error.
    -->
    <PackageVersion Include="WolverineFx.FluentValidation" Version="5.31.0" />
  </ItemGroup>
  <!-- Application Libraries -->
  <ItemGroup>
    <!--
      FluentValidation 12, not 11. WolverineFx.FluentValidation 5.31.0, the middleware that
      finally runs this repository's validators, depends on FluentValidation 12.0.0 or later, and
      innovayse-sso, whose wiring this follows, pins 12.* for the same reason.

      FluentValidation.AspNetCore 11.3.0 used to sit on the next line and is gone. It wires MVC
      auto-validation, which this API never called (no type from it appears anywhere in the
      solution), and it has no 12.x release, so keeping it would hold FluentValidation below the
      version the middleware needs.
    -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <!--
      Supplies AddValidatorsFromAssemblyContaining, which Program.cs calls to put the validators
      in the container where the Wolverine middleware looks for them.
    -->
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Fluid.Core" Version="2.31.0" />
    <PackageVersion Include="MailKit" Version="4.16.0" />
    <PackageVersion Include="Mapster" Version="7.4.0" />
    <PackageVersion Include="Otp.NET" Version="1.4.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.0.27" />
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>
  <!-- Roslyn / Tooling -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.14.0" />
  </ItemGroup>
  <!-- Testing -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="Moq" Version="4.20.70" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.0.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>