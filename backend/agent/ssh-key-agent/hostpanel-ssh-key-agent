#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
hostpanel-ssh-key-agent -- manages ED25519 public keys in hosting accounts' authorized_keys.

Installed once per managed hosting server. HostPanel reaches it over SSH as a dedicated management
user whose single authorized key is pinned to a forced command:

    restrict,command="sudo -n /usr/local/sbin/hostpanel-ssh-key-agent" ssh-ed25519 AAAA... hostpanel

and sudoers lets that user run exactly this file, with no arguments, as root. The agent reads
ONE JSON request from stdin and writes ONE JSON response to stdout. It never executes a shell,
never takes a path from the request, and touches only <home>/.ssh/authorized_keys of an account
that passes every eligibility check below.

Contract version 1 (see README.md beside this file for the full specification):

    {"v": 1, "op": "ping"}
    {"v": 1, "op": "status", "account": "<user>"}
    {"v": 1, "op": "list",   "account": "<user>"}
    {"v": 1, "op": "add",    "account": "<user>", "key_id": "<uuid>", "public_key": "ssh-ed25519 AAAA..."}
    {"v": 1, "op": "revoke", "account": "<user>", "key_id": "<uuid>"}
    {"v": 1, "op": "prepare-site", "account": "<user>", "domain": "<the account's domain>"}   (1.3.0+, opt-in)

Every response is {"v": 1, "ok": true, ...} or {"v": 1, "ok": false, "error": "<code>"}.

Only keys this agent wrote are ever listed or removed. They are recognised by the comment
"hostpanel:<key_id>"; a key the customer installed by hand is counted but never touched.

Security model, in order of what it defends against:
  * Request is size-capped and schema-checked; unknown fields and operations are refused.
  * The account name is a strict POSIX pattern, must resolve through the passwd database, must
    have uid >= min_uid, must not be on the deny list, and its home must sit directly under
    home_root. A name never becomes a path; the path comes from the passwd entry.
  * All file work happens in a forked child that has dropped to the account's own uid/gid with
    no supplementary groups. A symlink planted by the customer can therefore reach nothing the
    customer could not already write, and files are created with the right owner by construction.
  * .ssh and authorized_keys are opened with O_NOFOLLOW relative to directory descriptors, and
    the replacement is written to an O_EXCL temp file, fsynced and renamed into place.
  * A per-account flock (in a root-owned directory) serialises concurrent requests.
  * Every mutating request is appended to the audit log by the root parent, success or failure.
"""

import base64
import configparser
import fcntl
import grp
import hashlib
import json
import os
import pwd
import re
try:
    import spwd  # removed in Python 3.13; absent means the lock check cannot run
except ImportError:  # pragma: no cover
    spwd = None
import signal
import stat
import subprocess
import sys
import time

CONTRACT_VERSION = 1
AGENT_VERSION = "1.3.1"
CONFIG_PATH = "/etc/hostpanel-ssh-key-agent/agent.conf"
MAX_REQUEST_BYTES = 16 * 1024
MAX_AUTHORIZED_KEYS_BYTES = 256 * 1024
# A client that connects and never sends (or never closes) stdin must not pin a root process.
STDIN_TIMEOUT_SECONDS = 10
# Ceiling on one whole request, lock wait included.
REQUEST_TIMEOUT_SECONDS = 60
TAG_PREFIX = "hostpanel:"
ACCOUNT_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
KEY_ID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
ED25519_LINE_RE = re.compile(r"^ssh-ed25519 ([A-Za-z0-9+/]{68}(?:==|=)?)(?: [^\r\n]*)?$")
DISABLED_SHELLS = {"/sbin/nologin", "/usr/sbin/nologin", "/bin/false", "/usr/bin/false", ""}

DEFAULTS = {
    "min_uid": "1000",
    "home_root": "/home",
    "deny_accounts": "root,admin,nobody,mysql,postfix,dovecot,named,apache,nginx",
    "max_keys": "50",
    "audit_log": "/var/log/hostpanel-ssh-key-agent.log",
    "lock_dir": "/run/hostpanel-ssh-key-agent",
    # Identity of this installation: which provider profile it runs and which HostPanel server
