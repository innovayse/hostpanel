JAIL_TIMEOUT_SECONDS = 30
WITHDRAWN_SHELL = "/sbin/nologin"


class AgentError(Exception):
    """A refusal with a stable, machine-readable code. The message is never sent to the caller."""

    def __init__(self, code, detail=""):
        super().__init__(detail or code)
        self.code = code
        self.detail = detail


def _binding(value):
    """The configured binding id, lower-cased; anything but a UUID or empty is a broken config."""
    value = value.strip().lower()
    if value and not KEY_ID_RE.match(value):
        raise AgentError("internal_error")
    return value


def load_config(path=CONFIG_PATH):
    """Reads agent.conf; a missing file means the defaults, never a crash."""
    parser = configparser.ConfigParser()
    parser.read_dict({"agent": DEFAULTS})
    if os.path.exists(path):
        parser.read(path)
    section = parser["agent"]
    return {
        "min_uid": int(section["min_uid"]),
        "home_root": os.path.realpath(section["home_root"]),
        "deny_accounts": {a.strip() for a in section["deny_accounts"].split(",") if a.strip()},
        "max_keys": int(section["max_keys"]),
        "audit_log": section["audit_log"],
        "lock_dir": section["lock_dir"],
        "provider": section["provider"].strip() or "generic-linux",
        "binding": _binding(section["binding"]),
        "ssh_group": section["ssh_group"].strip(),
        "eligible_list": section["eligible_list"].strip(),
        "account_check_command": section["account_check_command"].strip(),
        "check_shadow_lock": section.getboolean("check_shadow_lock"),
        "jail_enrol": section.getboolean("jail_enrol"),
        "jail_root": os.path.realpath(section["jail_root"]),
        "jail_group": section["jail_group"].strip(),
        "jail_sections": [x.strip() for x in section["jail_sections"].split(",") if x.strip()],
        "jail_shell": section["jail_shell"].strip(),
        "jail_extras": [x.strip() for x in section["jail_extras"].split(",") if x.strip()],
        "systemd_unit_dir": section["systemd_unit_dir"].strip(),
        "site_prepare_command": section["site_prepare_command"].strip(),
    }


# --------------------------------------------------------------------------- key handling

def parse_ed25519(public_key):
    """
    Validates an OpenSSH ED25519 public key line and returns (canonical_blob_b64, fingerprint).

    The customer's comment is discarded: the agent writes its own tag in its place, so nothing a
    customer types reaches authorized_keys except the base64 blob, which is re-encoded from bytes.
    """
    if not isinstance(public_key, str) or len(public_key) > 1024:
        raise AgentError("invalid_key")
    match = ED25519_LINE_RE.match(public_key.strip())
    if not match:
        raise AgentError("invalid_key")
    try:
        blob = base64.b64decode(match.group(1), validate=True)
    except (ValueError, TypeError):
        raise AgentError("invalid_key")
    # string "ssh-ed25519" (4-byte length + 11 bytes) then string key (4-byte length + 32 bytes).
    if len(blob) != 51 or blob[:15] != b"\x00\x00\x00\x0bssh-ed25519" or blob[15:19] != b"\x00\x00\x00\x20":
        raise AgentError("invalid_key")
    fingerprint = "SHA256:" + base64.b64encode(hashlib.sha256(blob).digest()).decode().rstrip("=")
    return base64.b64encode(blob).decode(), fingerprint


def fingerprint_of_line(line):
    """Fingerprint of any authorized_keys line whose key is ED25519, else None."""
    for token_index, token in enumerate(line.split()):
        if token == "ssh-ed25519":
            parts = line.split()
            if token_index + 1 < len(parts):
                try:
                    blob = base64.b64decode(parts[token_index + 1], validate=True)
                except (ValueError, TypeError):
                    return None
                return "SHA256:" + base64.b64encode(hashlib.sha256(blob).digest()).decode().rstrip("=")
    return None


def managed_key_id(line):
    """The key id of a line this agent wrote, or None for any other line."""
    parts = line.split()
    if len(parts) == 3 and parts[0] == "ssh-ed25519" and parts[2].startswith(TAG_PREFIX):
        key_id = parts[2][len(TAG_PREFIX):]
        if KEY_ID_RE.match(key_id):
            return key_id
    return None


# --------------------------------------------------------------------------- account checks

def _is_locked(name, getspnam):
    """
    True when the account's password is locked (`usermod -L` prefixes the hash with `!`, which is
    how CWP suspends an account). `!!`/`*` alone mean "no password set" and are not a lock.
    """
    if getspnam is None:
        return False
    try:
        hashed = getspnam(name).sp_pwdp
    except KeyError:
        return False
    except PermissionError:
        # Only root can read shadow; a lock check that cannot run must not pass silently.
        raise AgentError("internal_error")
    return hashed.startswith("!") and hashed.lstrip("!").startswith("$")


def _in_group(name, gid, group_name, getgrnam):
    """True when the account is in the group, as a member or through its primary group."""
    try:
        group = getgrnam(group_name)
    except KeyError:
        return False
    return name in group.gr_mem or group.gr_gid == gid


def _in_eligible_list(name, path):
    """True when the opt-in list (one account per line, root-owned) names the account."""
    try:
        st = os.stat(path, follow_symlinks=False)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
            raise AgentError("internal_error")
        with open(path, encoding="utf-8") as handle:
            return any(line.strip() == name for line in handle)
    except FileNotFoundError:
        return False


def _account_check(name, command, run=subprocess.run):
    """
    Asks the hosting panel whether `name` is one of its accounts, by running a root-owned helper
    with the name as its only argument: no shell, empty environment, short timeout. Exit 0 means
    yes, 1 means no, anything else is a fault.
    """
    if not os.path.isabs(command):
        raise AgentError("internal_error")
    try:
        done = run([command, name], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, env={"PATH": "/usr/bin:/bin"}, timeout=10, check=False)
    except (OSError, subprocess.TimeoutExpired):
        raise AgentError("internal_error")
    if done.returncode == 1:
        raise AgentError("account_not_found")
    if done.returncode != 0:
        raise AgentError("internal_error")


def resolve_account(name, config, getpwnam=pwd.getpwnam, getspnam=None, getgrnam=grp.getgrnam,
                    run=subprocess.run):
    """
    Resolves and vets the hosting account. The returned home path comes from passwd only.

    Identity checks (name, passwd, uid, home, panel account) refuse every operation. Access
    checks (suspension, shell, group, opt-in list) only decide whether the account may receive
    keys: listing and revoking stay possible, so access can always be taken away.
    """
    if getspnam is None and spwd is not None:
        getspnam = spwd.getspnam
    if not isinstance(name, str) or not ACCOUNT_RE.match(name):
        raise AgentError("invalid_account")
    if name in config["deny_accounts"]:
        raise AgentError("account_not_eligible")
    try:
        entry = getpwnam(name)
    except KeyError:
        raise AgentError("account_not_found")
    if entry.pw_uid < config["min_uid"] or entry.pw_uid == 0 or entry.pw_gid == 0:
        raise AgentError("account_not_eligible")
    home = os.path.realpath(entry.pw_dir)
    # The home must be exactly <home_root>/<something>, never the root itself or deeper.
    if os.path.dirname(home) != config["home_root"]:
        raise AgentError("account_not_eligible")
    if config.get("account_check_command"):
        _account_check(name, config["account_check_command"], run)

    suspended = bool(config.get("check_shadow_lock", True)) and _is_locked(name, getspnam)
    jailed = bool(config.get("jail_enrol")) and _in_group(name, entry.pw_gid, config["jail_group"], getgrnam)
    # With enrolment on, an account not yet jailed is still able to receive a key: adding the
    # first one is what gives it SSH.
    shell_ok = entry.pw_shell not in DISABLED_SHELLS or bool(config.get("jail_enrol"))
    eligible = True
    if config.get("ssh_group") and not _in_group(name, entry.pw_gid, config["ssh_group"], getgrnam):
        eligible = False
    if config.get("eligible_list") and not _in_eligible_list(name, config["eligible_list"]):
        eligible = False

    reason = None
    if suspended:
        reason = "account_suspended"
    elif not eligible:
        reason = "account_not_eligible"
    elif not shell_ok:
        reason = "ssh_disabled"

    return {
        "name": name,
        "uid": entry.pw_uid,
        "gid": entry.pw_gid,
        "home": home,
        "shell": entry.pw_shell,
        "jailed": jailed,
        "shell_enabled": reason is None,
        "reason": reason,
    }


# --------------------------------------------------------------------------- file work (runs as the account)

def _open_ssh_dir(home, create):
    """Opens <home>/.ssh as a directory descriptor without following symlinks."""
    home_fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        try:
            st = os.stat(".ssh", dir_fd=home_fd, follow_symlinks=False)
        except FileNotFoundError:
            if not create:
                return None
            os.mkdir(".ssh", 0o700, dir_fd=home_fd)
            st = os.stat(".ssh", dir_fd=home_fd, follow_symlinks=False)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
            raise AgentError("unsafe_path")
        return os.open(".ssh", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=home_fd)
    finally:
        os.close(home_fd)


def _read_lines(ssh_fd):
    """Reads authorized_keys (refusing symlinks and oversize files); missing means empty."""
    if ssh_fd is None:
        return []
    try:
        fd = os.open("authorized_keys", os.O_RDONLY | os.O_NOFOLLOW, dir_fd=ssh_fd)
    except FileNotFoundError:
        return []
    except OSError:
        raise AgentError("unsafe_path")
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid():
            raise AgentError("unsafe_path")
        if st.st_size > MAX_AUTHORIZED_KEYS_BYTES:
            raise AgentError("file_too_large")
        with os.fdopen(os.dup(fd), "r", encoding="utf-8", errors="replace") as handle:
            return handle.read().splitlines()
    finally:
        os.close(fd)


def _write_lines(ssh_fd, lines):
    """Atomically replaces authorized_keys: O_EXCL temp file, fsync, rename, fsync directory."""
    tmp_name = "authorized_keys.hostpanel.%d.tmp" % os.getpid()
    data = ("\n".join(lines) + "\n") if lines else ""
    fd = os.open(tmp_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=ssh_fd)
    try:
        os.write(fd, data.encode("utf-8"))
        os.fchmod(fd, 0o600)
        os.fsync(fd)
    except BaseException:
        os.close(fd)
        os.unlink(tmp_name, dir_fd=ssh_fd)
        raise
    os.close(fd)
    os.replace(tmp_name, "authorized_keys", src_dir_fd=ssh_fd, dst_dir_fd=ssh_fd)
    os.fsync(ssh_fd)


def _summarise(lines):
    managed, unmanaged = [], 0
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        key_id = managed_key_id(stripped)
        if key_id:
            managed.append({"key_id": key_id, "fingerprint": fingerprint_of_line(stripped)})
        else:
            unmanaged += 1
    return managed, unmanaged


def perform(request, account, config):
    """Executes one operation as the (already dropped-to) account user. Returns the response body."""
    op = request["op"]
    if op == "status":
        ssh_fd = _open_ssh_dir(account["home"], create=False)
        try:
            managed, unmanaged = _summarise(_read_lines(ssh_fd))
        finally:
            if ssh_fd is not None:
                os.close(ssh_fd)
        status = {"shell_enabled": account["shell_enabled"], "managed_keys": len(managed), "unmanaged_keys": unmanaged}
        if account.get("reason"):
            status["reason"] = account["reason"]
        return status

    if op == "list":
        ssh_fd = _open_ssh_dir(account["home"], create=False)
        try:
            managed, unmanaged = _summarise(_read_lines(ssh_fd))
        finally:
            if ssh_fd is not None:
                os.close(ssh_fd)
        return {"keys": managed, "unmanaged_keys": unmanaged}

    if op == "add":
        if not account["shell_enabled"]:
            raise AgentError(account.get("reason") or "ssh_disabled")
        blob_b64, fingerprint = parse_ed25519(request["public_key"])
        key_id = request["key_id"]
        ssh_fd = _open_ssh_dir(account["home"], create=True)
        try:
            lines = _read_lines(ssh_fd)
            for line in lines:
                stripped = line.strip()
                existing_id = managed_key_id(stripped)
                if fingerprint_of_line(stripped) == fingerprint:
                    if existing_id == key_id:
                        return {"key_id": key_id, "fingerprint": fingerprint, "changed": False}
                    raise AgentError("duplicate_key")
                if existing_id == key_id:
                    raise AgentError("key_id_conflict")
            managed, _ = _summarise(lines)
            if len(managed) >= config["max_keys"]:
                raise AgentError("too_many_keys")
            lines.append("ssh-ed25519 %s %s%s" % (blob_b64, TAG_PREFIX, key_id))
            _write_lines(ssh_fd, lines)
        finally:
            os.close(ssh_fd)
        return {"key_id": key_id, "fingerprint": fingerprint, "changed": True}

    if op == "revoke":
        key_id = request["key_id"]
        ssh_fd = _open_ssh_dir(account["home"], create=False)
        if ssh_fd is None:
            return {"key_id": key_id, "changed": False}
        try:
            lines = _read_lines(ssh_fd)
            kept = [line for line in lines if managed_key_id(line.strip()) != key_id]
            if len(kept) == len(lines):
                return {"key_id": key_id, "changed": False}
            _write_lines(ssh_fd, kept)
        finally:
            os.close(ssh_fd)
        return {"key_id": key_id, "changed": True}

    raise AgentError("unknown_operation")


# --------------------------------------------------------------------------- jailed SSH (root)

def _jail_run(argv):
    """Runs one jail command: absolute path, no shell, fixed environment, bounded time."""
    if not os.path.isabs(argv[0]):
        raise AgentError("internal_error")
    try:
        done = JAIL_RUN(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                        env=dict(JAIL_ENV), timeout=JAIL_TIMEOUT_SECONDS, check=False, text=True)
    except (OSError, subprocess.TimeoutExpired):
        raise AgentError("internal_error")
    if done.returncode != 0:
        raise AgentError("internal_error")
    return done.stdout or ""


def _root_dir(path):
    """Creates a directory owned by root, not writable by anyone else; refuses a symlink."""
    if os.path.islink(path):
        raise AgentError("internal_error")
    os.makedirs(path, mode=0o755, exist_ok=True)
    if os.geteuid() == 0:
        os.chown(path, 0, 0)
    os.chmod(path, 0o755)


def _jail_identity(jail, account):
    """Puts the account in the jail's own passwd/group so the shell inside knows who it is."""
    etc = os.path.join(jail, "etc")
    _root_dir(etc)
    rows = {
        "passwd": "%s:x:%d:%d::%s:%s\n" % (account["name"], account["uid"], account["gid"],
                                            account["home"], account.get("jail_shell", "/bin/bash")),
        "group": "%s:x:%d:\n" % (account["name"], account["gid"]),
    }
    for name, row in rows.items():
        path = os.path.join(etc, name)
        if os.path.islink(path):
            raise AgentError("internal_error")
        existing = ""
        if os.path.exists(path):
            with open(path, encoding="utf-8") as handle:
                existing = handle.read()
        if any(line.split(":", 1)[0] == account["name"] for line in existing.splitlines()):
            continue
        with open(path, "a", encoding="utf-8") as handle:
            handle.write(row)


def _host_files(path):
    """The host path itself, or every entry below it when it is a directory (links not followed)."""
    if not os.path.isdir(path) or os.path.islink(path):
        return [path]
    found = []
    for parent, dirs, files in os.walk(path):
        found.extend(os.path.join(parent, entry) for entry in dirs + files)
    return found


def _jail_copy_is_stale(jail, extra):
    """
    Whether jk_cp has to copy the extra again: some file of it is missing in the jail, or the
    host copy differs in size or is newer (a package update). jk_cp resolves and copies every
    binary's libraries, which costs seconds of CPU per binary, so an extra already in place is
    left alone; the check itself only stats files. Times are compared in whole seconds because
    jk_cp keeps a file's time but drops its fraction.
    """
    for source in _host_files(extra):
        target = os.path.join(jail, source.lstrip("/"))
        try:
            host = os.lstat(source)
            copy = os.lstat(target)
        except FileNotFoundError:
            return True
        if stat.S_ISLNK(host.st_mode) or stat.S_ISDIR(host.st_mode):
            continue
        if copy.st_size != host.st_size or int(copy.st_mtime) < int(host.st_mtime):
            return True
    return False


def enrol_jail(account, config):
    """
    Gives the account jailed SSH, matching the customer sshd's `Match Group <jail_group>` with
    `ChrootDirectory <jail_root>/%u`. Every step is skipped when already done. Customer files are
    never moved: the real home is bind-mounted into the jail by a persistent systemd mount unit.
    """
    name = account["name"]
    jail_root = config["jail_root"]
    jail = os.path.join(jail_root, name)
    if os.path.dirname(jail) != jail_root:
        raise AgentError("internal_error")
    _root_dir(jail_root)
    if not os.path.isdir(os.path.join(jail, "etc")):
        _root_dir(jail)
        _jail_run(["/usr/sbin/jk_init", "-f", "-j", jail] + list(config["jail_sections"]))
    extras = [p for p in config.get("jail_extras", []) if os.path.isabs(p) and os.path.exists(p)]
    stale = [p for p in extras if _jail_copy_is_stale(jail, p)]
    if stale:
        _jail_run(["/usr/sbin/jk_cp", "-f", "-j", jail] + stale)
    _jail_identity(jail, dict(account, jail_shell=config["jail_shell"]))

    where = os.path.join(jail, "home", name)
    _root_dir(os.path.join(jail, "home"))
    if not os.path.isdir(where):
        os.mkdir(where, 0o755)
    if not os.path.ismount(where):
        unit = _jail_run(["/usr/bin/systemd-escape", "-p", "--suffix=mount", where]).strip()
        if not re.match(r"^[A-Za-z0-9_.\\-]+\.mount$", unit):
            raise AgentError("internal_error")
        unit_path = os.path.join(config["systemd_unit_dir"], unit)
        if not os.path.exists(unit_path):
            with open(unit_path, "w", encoding="utf-8") as handle:
                handle.write(
                    "[Unit]\nDescription=HostPanel jailed SSH: home of %s\n\n"
                    "[Mount]\nWhat=%s\nWhere=%s\nType=none\nOptions=bind\n\n"
                    "[Install]\nWantedBy=multi-user.target\n" % (name, account["home"], where))
            _jail_run(["/usr/bin/systemctl", "daemon-reload"])
        _jail_run(["/usr/bin/systemctl", "enable", "--now", unit])

    if not account.get("jailed"):
        _jail_run(["/usr/sbin/usermod", "-aG", config["jail_group"], name])
    if account.get("shell") in DISABLED_SHELLS:
        _jail_run(["/usr/sbin/usermod", "-s", config["jail_shell"], name])
    audit_event(config, name, "jail_enrol")


def withdraw_jail(account, config):
    """Takes SSH away again; the jail and its mount stay so re-enrolment is cheap."""
    name = account["name"]
    _jail_run(["/usr/bin/gpasswd", "-d", name, config["jail_group"]])
    if account.get("shell") == config["jail_shell"]:
        _jail_run(["/usr/sbin/usermod", "-s", WITHDRAWN_SHELL, name])
    audit_event(config, name, "jail_withdraw")


# --------------------------------------------------------------------------- request handling (root)

REQUIRED_FIELDS = {
    "ping": set(),
    "status": {"account"},
    "list": {"account"},
    "add": {"account", "key_id", "public_key"},
    "revoke": {"account", "key_id"},
    "prepare-site": {"account", "domain"},
}

DOMAIN_RE = re.compile(r"^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$")
SITE_PREPARE_TIMEOUT_SECONDS = 600
SITE_PREPARE_STEP_RE = re.compile(r"^\[provision [a-z0-9]+\] (.{1,200})$")


def validate_request(raw):
    """Parses and schema-checks the request. Unknown fields are refused, not ignored."""
    if len(raw) > MAX_REQUEST_BYTES:
        raise AgentError("request_too_large")
    try:
        request = json.loads(raw)
    except ValueError:
        raise AgentError("invalid_request")
    if not isinstance(request, dict) or request.get("v") != CONTRACT_VERSION:
        raise AgentError("unsupported_version")
    op = request.get("op")
    if op not in REQUIRED_FIELDS:
        raise AgentError("unknown_operation")
    allowed = {"v", "op"} | REQUIRED_FIELDS[op]
    if set(request) != allowed:
        raise AgentError("invalid_request")
    if "key_id" in request and (not isinstance(request["key_id"], str) or not KEY_ID_RE.match(request["key_id"])):
        raise AgentError("invalid_request")
    if "domain" in request and (not isinstance(request["domain"], str) or not DOMAIN_RE.match(request["domain"])):
        raise AgentError("invalid_request")
    return request


def prepare_site(account, domain, config, run=subprocess.run):
    """
    Root side: runs the provider's site-prepare helper for <account> <domain> and returns its step lines.

    The helper owns the server-specific work and is idempotent; it must refuse (exit 3) a domain that
    is not the account's own. Exit 3 -> site_not_owned, any other failure or a timeout -> site_prepare_failed.
    """
    command = config.get("site_prepare_command", "")
    if not command:
        raise AgentError("not_supported")
    try:
        done = run([command, account["name"], domain], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                   stderr=subprocess.DEVNULL, env=dict(JAIL_ENV), timeout=SITE_PREPARE_TIMEOUT_SECONDS,
                   check=False, text=True)
    except (OSError, subprocess.SubprocessError):
        raise AgentError("site_prepare_failed")
    if done.returncode == 3:
        raise AgentError("site_not_owned")
    if done.returncode != 0:
        raise AgentError("site_prepare_failed")
    steps = []
    for line in (done.stdout or "").splitlines():
        match = SITE_PREPARE_STEP_RE.match(line.strip())
        if match:
            steps.append(match.group(1))
    audit_event(config, account["name"], "site_prepare")
    return {"prepared": True, "steps": steps[:50]}


def run_as_account(request, account, config):
    """Forks, drops the child to the account's uid/gid, runs the operation there, returns its result."""
    if os.geteuid() == account["uid"]:
        # Already the account (tests run this way); no privilege to drop.
        return perform(request, account, config)
    read_fd, write_fd = os.pipe()
    pid = os.fork()
    if pid == 0:
        os.close(read_fd)
        try:
            os.setgroups([])
            os.setgid(account["gid"])
            os.setuid(account["uid"])
            os.umask(0o077)
            body = {"ok": True, "result": perform(request, account, config)}
        except AgentError as exc:
            body = {"ok": False, "error": exc.code}
        except Exception:  # noqa: BLE001 -- the child must always answer
            body = {"ok": False, "error": "internal_error"}
        os.write(write_fd, json.dumps(body).encode())
        os._exit(0)
    os.close(write_fd)
    chunks = []
    while True:
        chunk = os.read(read_fd, 65536)
        if not chunk:
            break
        chunks.append(chunk)
    os.close(read_fd)
    os.waitpid(pid, 0)
    try:
        body = json.loads(b"".join(chunks) or b"{}")
    except ValueError:
        raise AgentError("internal_error")
    if not body.get("ok"):
        raise AgentError(body.get("error", "internal_error"))
    return body["result"]


def audit_event(config, account, event):
    """Appends one line for a root-side change that is not a key operation (jail enrol/withdraw)."""
    entry = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "op": event, "account": account,
             "outcome": "ok", "client": os.environ.get("SUDO_USER", "")}
    try:
        fd = os.open(config["audit_log"], os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "a") as handle:
            handle.write(json.dumps(entry) + "\n")
    except OSError:
        pass


def audit(config, request, outcome):
    """Appends one line per mutating request. Never contains key material beyond the fingerprint."""
    if request is None or request.get("op") not in ("add", "revoke"):
        return
    entry = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "op": request.get("op"),
        "account": request.get("account"),
        "key_id": request.get("key_id"),
        "outcome": outcome,
        "client": os.environ.get("SUDO_USER", ""),
    }
    if request.get("op") == "add":
        try:
            entry["fingerprint"] = parse_ed25519(request.get("public_key"))[1]
        except AgentError:
            entry["fingerprint"] = None
    try:
        fd = os.open(config["audit_log"], os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "a") as handle:
            handle.write(json.dumps(entry) + "\n")
    except OSError:
        pass


def handle(raw, config):
    """Full request lifecycle. Returns the response dict; never raises."""
    request = None
    try:
        request = validate_request(raw)
        if request["op"] == "ping":
            return {"v": CONTRACT_VERSION, "ok": True, "agent_version": AGENT_VERSION,
                    "provider": config.get("provider", "generic-linux"), "binding": config.get("binding", "")}
        account = resolve_account(request["account"], config)
        os.makedirs(config["lock_dir"], mode=0o700, exist_ok=True)
        lock_fd = os.open(os.path.join(config["lock_dir"], account["name"] + ".lock"),
                          os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX)
            jail = bool(config.get("jail_enrol"))
            if request["op"] == "prepare-site":
                if not config.get("site_prepare_command"):
                    raise AgentError("not_supported")
                if jail and account["shell_enabled"]:
                    # The helper puts PHP into the jail; make sure the jail exists first.
                    enrol_jail(account, config)
                result = prepare_site(account, request["domain"], config)
                audit(config, request, "ok")
                response = {"v": CONTRACT_VERSION, "ok": True}
                response.update(result)
                return response
            if jail and request["op"] == "add" and account["shell_enabled"]:
                # Before the key is written: a key that lands but cannot log in is worse than none.
                enrol_jail(account, config)
            result = run_as_account(request, account, config)
            if jail and request["op"] == "revoke" and result.get("changed") and account["jailed"]:
                left = run_as_account({"v": CONTRACT_VERSION, "op": "list", "account": account["name"]},
                                      account, config)
                # Hand-installed keys are the customer's own way in; leave their access alone.
                if not left["keys"] and not left["unmanaged_keys"]:
                    withdraw_jail(account, config)
        finally:
            os.close(lock_fd)
        audit(config, request, "ok")
        response = {"v": CONTRACT_VERSION, "ok": True}
        response.update(result)
        return response
    except AgentError as exc:
        audit(config, request, exc.code)
        return {"v": CONTRACT_VERSION, "ok": False, "error": exc.code}
    except Exception:  # noqa: BLE001 -- the caller gets a code, never a traceback
        audit(config, request, "internal_error")
        return {"v": CONTRACT_VERSION, "ok": False, "error": "internal_error"}


def _on_timeout(signum, frame):
    raise AgentError("timeout")


def main():
    signal.signal(signal.SIGALRM, _on_timeout)
    signal.alarm(STDIN_TIMEOUT_SECONDS)
    try:
        raw = sys.stdin.buffer.read(MAX_REQUEST_BYTES + 1).decode("utf-8", errors="replace")
    except AgentError:
        sys.stdout.write(json.dumps({"v": CONTRACT_VERSION, "ok": False, "error": "timeout"}) + "\n")
        return 1
    # handle() turns the AgentError raised by a later alarm into an ordinary refusal.
    signal.alarm(REQUEST_TIMEOUT_SECONDS)
    try:
        config = load_config()
    except AgentError as exc:
        sys.stdout.write(json.dumps({"v": CONTRACT_VERSION, "ok": False, "error": exc.code}) + "\n")
        return 1
    response = handle(raw, config)
    signal.alarm(0)
    sys.stdout.write(json.dumps(response) + "\n")
    sys.stdout.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())
