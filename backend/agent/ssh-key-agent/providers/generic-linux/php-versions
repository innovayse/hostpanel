#!/usr/bin/env bash
# What: lists the PHP versions this server offers, one "N.N<TAB>/abs/path/to/php" per line, oldest first (agent: ping
#       `php_versions` and `php_cli`). A version counts when its php-fpm binary, pool directory and CLI are all there,
#       on Debian and Ubuntu (sury), on RHEL with Remi and on the RHEL AppStream. ensure-website accepts exactly these.
#       Prints nothing when none is installed. Read only.
# Usage (root, called by hostpanel-ssh-key-agent): php-versions
# Exit: 0 always unless the arguments are wrong (2).
set -euo pipefail
HELPER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=hp-common.sh
. "$HELPER_DIR/hp-common.sh"

[ $# -eq 0 ] || hp_die "$EXIT_BAD_ARGS" "usage: php-versions"
hp_php_versions
