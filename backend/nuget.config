<?xml version="1.0" encoding="utf-8"?>
<!--
  Innovayse.Auth is published from the innovayse-sso project, which lives in another
  directory of the workspace and is not visible from this product's Docker build
  context. It is consumed as a package rather than as a project reference on purpose:
  this repository has to build from a clone of itself alone, and a source reference to
  a sibling directory would end that the first time someone deployed calendar on its
  own server.

  Credentials are deliberately absent from this file. NuGet reads them from the
  environment instead:

      NUGET_PACKAGE_SOURCE_CREDENTIALS_innovayse=Username=gitlab-ci-token;Password=<token>

  CI supplies its own job token; locally, a personal access token with read_api scope.
  The earlier version of this file carried a <packageSourceCredentials> block filled
  from %VARS%, which failed in a worse way than it looks: with the variable unset,
  NuGet rejected the empty password before it consulted any source at all, so a
  restore that would have succeeded from a local feed never got that far.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  <!--
    Addressed by numeric project id, not by the URL-encoded namespace path.
    GitLab's NuGet endpoint only accepts the id: the encoded form answers 400 to
    every request, with or without credentials, and NuGet reports that as NU1301
    "unable to load the service index" — which reads like an authentication
    problem it is not. It is what stopped this API restoring on the staging box.
  -->
    <add key="innovayse"
         value="https://gitlab.com/api/v4/projects/83923963/packages/nuget/index.json" />
  </packageSources>
  <!--
    Where the vulnerability audit gets its data. Without this block NuGet asks EVERY
    package source, and a source it cannot reach is reported as NU1900 — which
    src/Directory.Build.props turns into an error, because TreatWarningsAsErrors is
    on. The registry above needs a token, so a clone without one failed to build
    Innovayse.SDK, .Domain and .Application: projects that reference nothing from it.
    A repository that cannot be compiled from a plain clone is exactly what
    consuming Innovayse.Auth as a package instead of a project reference was meant
    to avoid.

    Naming nuget.org here restricts the audit to it. Nothing is suppressed: a real
    advisory still surfaces (NU1901-NU1904) and still fails the build, and it comes
    from the only source that publishes advisories anyway — a GitLab package
    registry serves packages, not vulnerability data.
  -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </auditSources>
  <!--
    Central package management (Directory.Packages.props) treats unmapped multi-source
    setups as an error (NU1507): with two sources and no map, NuGet would ask both for
    every package. The map sends exactly one package to the private registry and
    everything else to nuget.org — which also stops the registry being probed for
    public packages it will never have.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="innovayse">
      <package pattern="Innovayse.Auth" />
    </packageSource>
  </packageSourceMapping>
</configuration>
