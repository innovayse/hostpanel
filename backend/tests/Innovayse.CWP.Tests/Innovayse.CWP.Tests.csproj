<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      net9.0, like every other test project here. A test assembly is launched by the
      test host, so its target framework has to be one the machine can actually run,
      unlike the library it covers, which net9.0 consumes happily either way. The CI
      image is the 9.0 SDK and carries no 8.0 runtime, so this one assembly aborted
      with "To install missing framework ... framework_version=8.0.0" while the other
      four ran and passed. Innovayse.Providers.CWP itself stays on net8.0; nothing
      about running its tests requires changing that.
    -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The stub server hosts Kestrel, so the test assembly needs the ASP.NET Core shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Microsoft.AspNetCore.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- One stub HTTP server for every adapter test project: linked, not copied. -->
    <Compile Include="..\Innovayse.Hostpanel.Integration.Tests\Fixtures\StubHttpServer.cs" Link="Fixtures\StubHttpServer.cs" />
    <Compile Include="..\Innovayse.Hostpanel.Integration.Tests\Fixtures\StubReply.cs" Link="Fixtures\StubReply.cs" />
    <Compile Include="..\Innovayse.Hostpanel.Integration.Tests\Fixtures\RecordedCall.cs" Link="Fixtures\RecordedCall.cs" />
    <Compile Include="..\Innovayse.Hostpanel.Integration.Tests\Fixtures\RedirectToStubHandler.cs" Link="Fixtures\RedirectToStubHandler.cs" />
    <Compile Include="..\Innovayse.Hostpanel.Integration.Tests\Fixtures\StubHttpClientFactory.cs" Link="Fixtures\StubHttpClientFactory.cs" />
    <ProjectReference Include="..\..\src\Innovayse.Providers.CWP\Innovayse.Providers.CWP.csproj" />
  </ItemGroup>
</Project>
