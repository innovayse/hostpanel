<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Settings inherited from Directory.Build.props -->
    <IsPackable>false</IsPackable>
    <!-- Native-memory settings for the test host, see the file (issue 373). -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/integration.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- A real Redis for Adapters/Auth/PortalSessionRevokerTests. -->
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <!-- Reads the invoice PDFs back so Adapters/Pdf and the PDF endpoint tests assert on their text. -->
    <PackageReference Include="PdfPig" />
    <!-- Options<T> wrapping for the Adapters/Integrations/* provider settings in the tests moved from Infrastructure.Tests. -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Innovayse.Hostpanel.API\Innovayse.Hostpanel.API.csproj" />
    <!--
      Named explicitly rather than leant on transitively: Cwp7ApiClientTests
      (Adapters/Integrations/Cwp7) constructs the internal Cwp7ApiClient directly, and the
      InternalsVisibleTo that permits it is declared in this project's own file.
    -->
    <ProjectReference Include="..\..\src\Innovayse.Providers.CWP7\Innovayse.Providers.CWP7.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\model-diff-baseline.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The message store schema Wolverine 5.41 created (WolverineStartupTests starts the current version on it). -->
    <None Include="Fixtures\wolverine-5.41-schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <!-- Caps how many test classes run at once: each starts an API host, and starting one compiles Wolverine's handler code, which takes gigabytes of native memory for a moment (issue 373). -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
