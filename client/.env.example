# Client portal (Nuxt): every key nuxt.config.ts reads from process.env. Used by `yarn dev` run directly in client/;
# the compose stacks pass the same values from docker/.env (a built image takes the NUXT_* override names).
# Contact-form mail and the chat notification bot belong to the API (docker/.env), not to this app.
# Copy to .env. Placeholders only: no defaults and no real secrets in this file.

# --- server-side runtimeConfig ---

# local or sso: how visitors sign in
AUTH_MODE=

# internal address of the hostpanel API, e.g. http://hostpanel-api:5148
API_URL=

# internal address of the SSO (sso mode)
SSO_URL=

# browser-facing address of the SSO (sso mode)
SSO_PUBLIC_URL=

# this portal's OIDC client id (sso mode)
SSO_CLIENT_ID=

# the issuer the SSO declares in its openid-configuration (sso mode); leave empty when it is the
# same as SSO_PUBLIC_URL. Compared exactly, so write it as the SSO does. A callback or ID token
# naming another issuer ends the sign-in. A built image takes it as NUXT_SSO_ISSUER.
SSO_ISSUER=

# this portal's OIDC client secret (sso mode); the same value as the API's CLIENT_HOSTPANEL_SECRET, set it only in the real .env
NUXT_SSO_CLIENT_SECRET=

# where the SSO returns after sign-in, https://<domain>/api/portal/auth/sso/callback
SSO_CALLBACK_URL=

# Redis that keeps the signed-in sessions, the same value as the API's REDIS_CONNECTION (host:port[,password=...]);
# empty keeps them in this process's memory, which only suits a single process such as local development
SESSION_REDIS=

# Key the stored sessions are encrypted with (AES-256-GCM): 32 random bytes, base64-encoded, e.g. `openssl rand -base64 32`.
# Required whenever SESSION_REDIS is set and the app does not run in development: the server refuses to start without it.
# A built image takes it as NUXT_SESSION_ENCRYPTION_KEY. Set it only in the real .env; changing it signs everyone out.
NUXT_SESSION_ENCRYPTION_KEY=

# billing-portal address for hand-off links, no trailing slash; empty hides the links
BILLING_PORTAL_URL=

# Stripe.js publishable key (public by design); empty disables card entry
STRIPE_PUBLISHABLE_KEY=

# --- public runtimeConfig ---

# canonical public URL of the portal
NUXT_PUBLIC_BASE_URL=

# public URL of the main portal (apps launcher script)
NUXT_PUBLIC_MAIN_URL=

# apps launcher: tasks app URL; empty drops the entry
NUXT_PUBLIC_TASKS_URL=

# apps launcher: ERP app URL; empty drops the entry
NUXT_PUBLIC_ERP_URL=

# apps launcher: sheets app URL; empty drops the entry
NUXT_PUBLIC_SHEETS_URL=

# apps launcher: email app URL; empty drops the entry
NUXT_PUBLIC_EMAIL_URL=

# apps launcher: drive app URL; empty drops the entry
NUXT_PUBLIC_DRIVE_URL=

# storefront design name (see templates/registry.ts); empty uses the default, classic
NUXT_PUBLIC_PORTAL_TEMPLATE=

# true shows the apps launcher in the header
NUXT_PUBLIC_PORTAL_APPS_ENABLED=

# site name fallback; the admin panel's setting wins
NUXT_PUBLIC_PORTAL_SITE_NAME=

# site tagline fallback
NUXT_PUBLIC_PORTAL_SITE_TAGLINE=

# default colour mode: light or dark
NUXT_PUBLIC_PORTAL_THEME_DEFAULT=

# true lets visitors switch colour mode
NUXT_PUBLIC_PORTAL_THEME_USER_TOGGLE=

# logo URL (light background)
NUXT_PUBLIC_PORTAL_LOGO=

# logo URL (dark background)
NUXT_PUBLIC_PORTAL_LOGO_DARK=

# square logo mark URL
NUXT_PUBLIC_PORTAL_LOGO_MARK=

# favicon URL
NUXT_PUBLIC_PORTAL_FAVICON=

# primary brand colour, e.g. #RRGGBB
NUXT_PUBLIC_PORTAL_BRAND_PRIMARY=

# accent brand colour, e.g. #RRGGBB
NUXT_PUBLIC_PORTAL_BRAND_ACCENT=

# heading font family
NUXT_PUBLIC_PORTAL_BRAND_FONT_HEADING=

# body font family
NUXT_PUBLIC_PORTAL_BRAND_FONT_BODY=

# Google Tag Manager id, GTM-XXXXXXX; empty disables it
NUXT_PUBLIC_PORTAL_GTM_ID=

# live-chat provider name; empty disables the widget
NUXT_PUBLIC_PORTAL_CHAT_PROVIDER=

# live-chat server address
NUXT_PUBLIC_PORTAL_CHAT_BASE_URL=

# live-chat website token (default locale)
NUXT_PUBLIC_PORTAL_CHAT_WEBSITE_TOKEN=

# live-chat website token (ru)
NUXT_PUBLIC_PORTAL_CHAT_WEBSITE_TOKEN_RU=

# live-chat website token (hy)
NUXT_PUBLIC_PORTAL_CHAT_WEBSITE_TOKEN_HY=

# WhatsApp contact link or number
NUXT_PUBLIC_PORTAL_WHATSAPP=

# Telegram contact link
NUXT_PUBLIC_PORTAL_TELEGRAM=

# newsletter sign-up endpoint
NUXT_PUBLIC_PORTAL_NEWSLETTER_URL=

# public contact e-mail shown on the site
NUXT_PUBLIC_PORTAL_CONTACT_EMAIL=

# public contact phone shown on the site
NUXT_PUBLIC_PORTAL_CONTACT_PHONE=

# support working hours shown on the contact page, e.g. the days and times; empty hides the row
NUXT_PUBLIC_PORTAL_CONTACT_HOURS=

# time zone the working hours are given in; shown after the hours, ignored when they are empty
NUXT_PUBLIC_PORTAL_CONTACT_TIMEZONE=

# Facebook page URL
NUXT_PUBLIC_PORTAL_SOCIAL_FACEBOOK=

# Instagram profile URL
NUXT_PUBLIC_PORTAL_SOCIAL_INSTAGRAM=

# X / Twitter profile URL; empty hides the footer icon
NUXT_PUBLIC_PORTAL_SOCIAL_TWITTER=

# LinkedIn page URL
NUXT_PUBLIC_PORTAL_SOCIAL_LINKEDIN=

# YouTube channel URL
NUXT_PUBLIC_PORTAL_SOCIAL_YOUTUBE=

# hosting demo site URL linked from the home products section; empty hides the link
NUXT_PUBLIC_PORTAL_HOSTING_DEMO_URL=

# company tax id shown in the footer
NUXT_PUBLIC_PORTAL_LEGAL_TAX_ID=

# CDN origin for built assets; empty serves them from the app
NUXT_APP_CDN_URL=
