# ── General ──────────────────────────────────────────────────────────────────
# Development also runs DevDataSeeder, so a deployed host left on it re-seeds test
# data on every restart. Migrations run in every environment except Testing.
ASPNETCORE_ENVIRONMENT=Development

# `local` is the standalone, self-hosted path: hostpanel authenticates its own users
# from its own table, and it is the only mode a plain clone can build. `sso` delegates sign-in
# to an external OpenID Connect provider, needs credentials for the private package feed (see below),
# and registers no local credentials.
AUTH_MODE=local

# Application name the API registers with the auth layer (cookie and client naming). One value for
# every stack: the dev, prod and hub compose files all read it.
AUTH_APP_NAME=hostpanel

# Edge proxy (nginx in the prod stacks, Caddy in the hub stack)
DOMAIN=yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com
# Absolute URL of the admin panel (scheme included, no trailing slash): the base of the links the API
# mails to staff. Prod/hub only (install.sh sets it); the dev stack uses CORS_ADMIN_ORIGIN.
ADMIN_BASE_URL=https://admin.yourdomain.com
# Absolute URL of the client portal (scheme included, no trailing slash): the base of the links the API
# mails to clients (verification, password reset, invoices). Prod/hub only (install.sh sets it); the dev
# stack uses CORS_CLIENT_ORIGIN.
CLIENT_BASE_URL=https://yourdomain.com
# Optional. The public address(es) this HostPanel connects to managed servers' SSH key agents from, as
# those servers see it (after NAT), comma-separated, e.g. 203.0.113.10. Servers -> SSH then shows the exact
# firewall (CSF, firewalld, ufw) and sshd lines that let only this address in. Prod/hub only.
SSH_AGENT_SOURCE_ADDRESSES=
# Optional. Control panels whose API port is reachable only over a VPN, as hostname=address pairs,
# comma-separated, e.g. srv4.example.com=10.77.0.1. HostPanel dials that address but keeps the hostname
# for the request and TLS, so customer links and certificate checks are unchanged. Prod/hub only.
PANEL_HOST_ADDRESSES=

NUXT_PUBLIC_BASE_URL=https://panel.example.com
# The client container calls the API on the visitor's behalf and passes the visitor's address in
# X-Forwarded-For. The API honours that header only from the proxies it is told to trust
# (RateLimit__KnownProxies__N / RateLimit__KnownNetworks__N on the API service): the Docker network the
# client and edge containers share must be listed there, or every guest is rate limited as one caller
# and orders record the client container's address.
# Base path the admin SPA is served under (/ or /admin). Read by the admin container at start, not at build.
ADMIN_BASE_URL_PATH=/

# The workspace dev proxy's origin for this client, allowed alongside the localhost
# ports and the stage host above -- so a browser reaching the API through
# a local dev proxy hostname such as panel.example.test is not refused by CORS.
PANEL_DEV_ORIGIN=http://panel.example.test

# Secrets. Every CHANGE_ME below is a placeholder, not a default: the API refuses to start outside
# Development while a secret still holds one (or is too short). install.sh writes generated values;
# by hand, generate each with `openssl rand -hex 24` (JWT_SECRET: `openssl rand -hex 32`).

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=hostpanel-db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=innovayse_dev

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=hostpanel-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=CHANGE_ME

# ── Redis ────────────────────────────────────────────────────────────────────
# The admin's cookie sessions and the data protection key ring (sso mode), and in every mode the
# client portal's sign-in sessions (NUXT_SESSION_REDIS), which a back-channel logout ends from the API.
REDIS_CONNECTION=hostpanel-redis:6379

# Key the client portal encrypts its stored sessions with (AES-256-GCM): 32 random bytes, base64-encoded,
# e.g. `openssl rand -base64 32`. Required by the prod, hub and demo stacks, whose portal refuses to start without it
# (the dev stack leaves it empty). Changing it signs everyone out.
SESSION_ENCRYPTION_KEY=

# ── Mail ─────────────────────────────────────────────────────────────────────
# Read by hostpanel-api only; nothing in client/ reads them.
SMTP_HOST=hostpanel-mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# tls (STARTTLS, usually 587), ssl (implicit TLS, usually 465) or none (a local
# catcher). Required: unset or misspelt, the API refuses to start and names this key
# rather than come up and send the relay's password in the clear.
SMTP_ENCRYPTION=none
# Reaches the API as Smtp__From__Address / Smtp__From__Name. A real deployment sets
# its own -- a fresh install must not send as somebody else's address.
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Hostpanel

# Where the public contact form delivers. Unset, the form answers 503
# CONTACT_NOT_CONFIGURED instead of silently dropping messages.
EMAIL_TO=contact@yourdomain.com

# Contact addresses of the support departments created on a fresh install (reach the API as
# DefaultDepartments__*). They matter only on the first start: afterwards the departments are edited in
# the admin panel. Each must be a mailbox; a real deployment sets its own.
DEPARTMENT_SUPPORT_EMAIL=support@example.com
DEPARTMENT_BILLING_EMAIL=billing@example.com
DEPARTMENT_SALES_EMAIL=sales@example.com
DEPARTMENT_GENERAL_EMAIL=hello@example.com

# Order numbering and the invoice payment term are built in (ORD-0042, 7 days) and no stack passes
# them. To change them, set Orders__NumberPrefix, Orders__NumberDigits and Orders__InvoicePaymentTermDays
# on the API service in a compose override; a value that cannot number an order refuses startup.

# ── Telegram (optional) ──────────────────────────────────────────────────────
# The contact form also posts enquiries here. Both or neither: half a bot posts
# nowhere while looking configured, so the API refuses to start on it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── External sign-on (used with AUTH_MODE=sso; ignored under local) ─────
# The admin's callback is <origin that served the SPA>/api/auth/callback. Where that
# is a hostname of its own, register it as an extra redirect address at the provider.
# Address the API and the client reach the provider at, server to server.
SSO_URL=https://sso.example.com
# Where the BROWSER is sent to sign in: the provider's public hostname, the same host
# as the issuer stamped into every token. Not the provider's server-to-server address.
SSO_PUBLIC_URL=https://sso.example.com
SSO_CLIENT_ID=hostpanel
SSO_CALLBACK_URL=https://panel.example.com/api/portal/auth/sso/callback

# Machine credential hostpanel reads its user directory with. Must equal the service API key configured
# at the provider; generate with: openssl rand -base64 24
SSO_SERVICE_KEY=CHANGE_ME

# Secret the API exchanges the admin SPA's authorization code with, server to server;
# it never reaches a browser. Under AUTH_MODE=sso the API refuses to start without it.
CLIENT_HOSTPANEL_SECRET=CHANGE_ME

# Shared with the provider, which calls it to sign a user out of every connected application.
# Generate with: openssl rand -hex 24. A deployed host refuses to start while it is a placeholder or
# shorter than 16 characters; leave it empty only where no provider is connected (every such call is then refused).
HOSTPANEL_BACKCHANNEL_LOGOUT_KEY=CHANGE_ME

# ── Links to related applications ────────────────────────────────────────────
# Browser-facing addresses. An application left unset is hidden rather than broken.
# MAIN_APP_URL is the main site; the compose files pass it to the client as
# NUXT_PUBLIC_MAIN_URL, the name Nitro needs to override its frozen default.
MAIN_APP_URL=https://example.com
NUXT_PUBLIC_SHEETS_URL=https://sheets.example.com
NUXT_PUBLIC_EMAIL_URL=https://inbox.example.com
NUXT_PUBLIC_ERP_URL=https://erp.example.com
NUXT_PUBLIC_TASKS_URL=https://tasks.example.com
NUXT_PUBLIC_DRIVE_URL=https://drive.example.com

# ── Public site ──────────────────────────────────────────────────────────────
# Which template renders the storefront when the admin setting is empty: classic, aurora or nova.
# Empty or unknown values fall back to the built-in default, `classic`.
NUXT_PUBLIC_PORTAL_TEMPLATE=classic

# Whether the header offers the apps launcher. Off unless this deployment actually
# runs the products above -- each has a *.local default, so "has a value" cannot
# decide it. `portal.apps.enabled` in the admin panel wins over this.
# Accepts true/1/yes/on.
NUXT_PUBLIC_PORTAL_APPS_ENABLED=false

# Public contact details and links. Each is optional: empty hides it from the footer / home page.
NUXT_PUBLIC_PORTAL_CONTACT_EMAIL=
NUXT_PUBLIC_PORTAL_SOCIAL_TWITTER=
NUXT_PUBLIC_PORTAL_SOCIAL_LINKEDIN=
NUXT_PUBLIC_PORTAL_SOCIAL_FACEBOOK=
# Address of a hosting demo site, linked from the home products section.
NUXT_PUBLIC_PORTAL_HOSTING_DEMO_URL=

# Optional home / contact page content. Empty is fine: the matching `portal.*` setting in the admin panel
# wins, and an empty value hides the element.
# Postal address and a map link for the contact page.
NUXT_PUBLIC_PORTAL_CONTACT_ADDRESS=
NUXT_PUBLIC_PORTAL_CONTACT_MAP_URL=
# Figures shown in the home page stats strip (free text, e.g. 5,000+ / 99.9% / 12).
NUXT_PUBLIC_PORTAL_STATS_CLIENTS=
NUXT_PUBLIC_PORTAL_STATS_UPTIME=
NUXT_PUBLIC_PORTAL_STATS_REGIONS=
# Short badge text above the home page headline.
NUXT_PUBLIC_PORTAL_HERO_BADGE=

# Branding fallbacks. Every one of these is managed from Admin → Settings once the
# install is up, and the admin value wins; set them here only for a first boot.
# Site name for the browser title, social previews and logo alt text.
NUXT_PUBLIC_PORTAL_SITE_NAME=
NUXT_PUBLIC_PORTAL_SITE_TAGLINE=
# Colour mode for a visitor with no saved choice: light, dark or system.
NUXT_PUBLIC_PORTAL_THEME_DEFAULT=dark
# Show the light/dark switch to visitors. Only the literal `false` hides it.
NUXT_PUBLIC_PORTAL_THEME_USER_TOGGLE=true
# Logo URLs: light background, dark background (falls back to the light one), and a
# square mark for compact places. Empty renders the built-in mark and wordmark.
NUXT_PUBLIC_PORTAL_LOGO=
NUXT_PUBLIC_PORTAL_LOGO_DARK=
NUXT_PUBLIC_PORTAL_LOGO_MARK=
NUXT_PUBLIC_PORTAL_FAVICON=
# Brand colours as #rrggbb; the whole primary/secondary scale is derived from each one.
# Empty keeps every template's own colours.
NUXT_PUBLIC_PORTAL_BRAND_PRIMARY=
NUXT_PUBLIC_PORTAL_BRAND_ACCENT=
# Typefaces: inter, noto-sans-armenian, noto-serif-armenian or system. Empty keeps the
# template's own. All are bundled with the storefront; none loads from a font CDN.
NUXT_PUBLIC_PORTAL_BRAND_FONT_HEADING=
NUXT_PUBLIC_PORTAL_BRAND_FONT_BODY=

# ── Tracking and live chat ───────────────────────────────────────────────────
# Nothing below loads until it is set. The tag also waits for the visitor to accept
# all cookies. All of these are managed from Admin → Settings too, which wins.
NUXT_PUBLIC_PORTAL_GTM_ID=
NUXT_PUBLIC_PORTAL_CHAT_BASE_URL=
NUXT_PUBLIC_PORTAL_CHAT_WEBSITE_TOKEN=
NUXT_PUBLIC_PORTAL_CHAT_WEBSITE_TOKEN_RU=
NUXT_PUBLIC_PORTAL_CHAT_WEBSITE_TOKEN_HY=

# ── Billing-portal handoff (optional) ─────────────────────────────────────────────────
# An address ONLY, no trailing slash. The API identifier/secret/access-key trio is
# gone on purpose: the billing API is called by hostpanel-api, never by the browser.
# Left empty, every handoff link is hidden rather than rendered broken.
BILLING_PORTAL_URL=

# ── Payments ─────────────────────────────────────────────────────────────────
# Payment gateway publishable key, public by design -- it identifies the account to
# the gateway's browser SDK and authorises nothing. The secret key does not belong here; billing
# runs through the billing portal. Empty means the card form has nothing to initialise.
STRIPE_PUBLISHABLE_KEY=

# ── Secrets ──────────────────────────────────────────────────────────────────
# At least 32 characters. The placeholder is long enough to start a Development stack and is refused elsewhere.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ISSUER=innovayse-api
JWT_AUDIENCE=innovayse-clients

# Local-mode session: access-token length, and the absolute age after which a session stops
# being renewed (sliding renewal re-issues the token while the person keeps working).
SESSION_ACCESS_TOKEN_MINUTES=15
SESSION_MAX_MINUTES=720

# Required outside Development. Without it the EF configurations silently drop their
# encrypted-column converters and server passwords, API tokens and access hashes are
# written in plain text. Must decode to exactly 32 bytes:
#   openssl rand -base64 32
# The value below is the base64 of a CHANGE_ME text: it starts a Development stack and is refused elsewhere.
ENCRYPTION_KEY=Q0hBTkdFX01FX0NIQU5HRV9NRV9DSEFOR0VfTUVfMDA=

# Private NuGet registry that publishes Innovayse.Auth. Only for AUTH_MODE=sso builds:
# leave it empty for a standalone install and the API builds without that package. Use a deploy token scoped to read_package_registry,
# never a personal access token.
#   NUGET_INNOVAYSE_CREDENTIALS=Username=<deploy-token-user>;Password=<token>
NUGET_INNOVAYSE_CREDENTIALS=

# ── API ─────────────────────────────────────────────────────────────────────
# Port the API listens on inside its container (ASPNETCORE_HTTP_PORTS). The edge
# proxy upstream is templated from it (nginx/templates/ in the prod stacks, caddy/Caddyfile in the hub stack);
# ci/Caddyfile.dev names it too: change all together.
API_PORT=5148

# Port the client portal listens on inside its container (NITRO_PORT). Templated into the same two edge
# configs, the dev port mapping and the dev healthcheck, so it is changed here only.
CLIENT_PORT=3000

# .NET garbage collector tuning for the API container (prod and hub stacks): workstation GC (0) or
# server GC (1), how aggressively memory is conserved (0-9), and the heap cap as a percentage of the
# container memory, so one API cannot take a shared host down.
API_GC_SERVER=0
API_GC_CONSERVE_MEMORY=5
API_GC_HEAP_HARD_LIMIT_PERCENT=75

# Host names the API answers to (AllowedHosts, semicolon-separated): exactly the public
# host, the container name and localhost. A deployed tier sets its public host.
ALLOWED_HOSTS=panel.example.test;hostpanel-api;localhost

# Trusted proxies (RateLimit__TrustedProxyCount, RateLimit__KnownNetworks__0). The API takes the caller's
# address from X-Forwarded-For only for this many hops, and only from proxies inside STACK_NETWORK_SUBNET.
# The dev, prod and hub stacks create their network with this subnet; the edge proxy and the client
# container sit on it, so 1 is right for every shipped stack. Pick a range no other network on the host
# uses. A chain with docker-compose.platform.yml joins an existing network: set its subnet here instead.
# Every extra proxy in front of the stack (a TLS terminator, a CDN) adds one to the count, and its
# address must be trusted too (docker/README.md, Trusted proxies), or every visitor shares one limit.
STACK_NETWORK_SUBNET=172.30.0.0/24
RATE_LIMIT_TRUSTED_PROXY_COUNT=1

# Proxies in front of the client portal (NUXT_TRUSTED_PROXY_COUNT). The portal forwards the visitor's address
# to the API as the Nth entry from the right of X-Forwarded-For, N being this count, and uses its own
# socket address when it is 0: an entry further left is written by the visitor and is never believed.
# The shipped prod, hub and demo stacks have one proxy (the edge) in front (the dev stack fixes it at 0). Every
# extra proxy in front of the edge (a TLS terminator, a CDN) adds one; too high a count is the unsafe direction.
CLIENT_TRUSTED_PROXY_COUNT=1

# Extra host names the client dev server answers to besides localhost (NUXT_DEV_ALLOWED_HOSTS, comma separated),
# for a dev stack reached through a proxy by name. Leave empty when the portal is opened on localhost.
CLIENT_DEV_ALLOWED_HOSTS=

# The same for the admin dev server (ADMIN_DEV_ALLOWED_HOSTS, comma separated). Leave empty for localhost.
ADMIN_DEV_ALLOWED_HOSTS=

# Set to true to disable the daily check for a newer Hostpanel release on GitHub. The check makes one
# outbound HTTPS request per day to api.github.com; disable it when the installation has no outbound
# internet access. When disabled the admin release-status banner never shows an upgrade notice.
# Maps to ScheduledJobs__DisableReleaseUpdateChecks.
DISABLE_RELEASE_UPDATE_CHECKS=false

# ── Published host ports and cross-product addresses ─────────────────────────
# Every value the compose files used to hard-code. Local ones below; a deployed tier
# sets its own through CI/CD variables. Secrets (POSTGRES_PASSWORD, RABBITMQ_PASSWORD,
# JWT_SECRET, ENCRYPTION_KEY) have no default in the compose files: unset, compose
# refuses to start.

# docker-compose.dev.yml (laptop): host side of each published port.
POSTGRES_HOST_PORT=5434
RABBITMQ_HOST_PORT=5673
RABBITMQ_MANAGEMENT_HOST_PORT=15673
MAILHOG_SMTP_HOST_PORT=1026
MAILHOG_UI_HOST_PORT=8027
API_HOST_PORT=5149
CLIENT_HOST_PORT=3001
ADMIN_HOST_PORT=5174

# Browser origins the API allows (docker-compose.dev.yml). PANEL_DEV_ORIGIN above is the third.
CORS_CLIENT_ORIGIN=http://localhost:3001
CORS_ADMIN_ORIGIN=http://localhost:5174
CORS_STAGE_ORIGIN=https://stage-panel.example.com

# docker-compose.prod.yml: host ports the bundled nginx publishes (a chain without the platform overlay).
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Largest request body the edge accepts on the client portal host, and on the admin host (nginx and
# caddy both read these two). Write the size with the M suffix (50M, 1M): both proxies accept it; K and G work too.
EDGE_MAX_BODY_SIZE=50M
EDGE_ADMIN_MAX_BODY_SIZE=1M

# Extra origins (space-separated) the client portal's Content-Security-Policy allows for scripts, connections,
# frames and images, on top of its own origin and the payment provider: a chat server, other analytics.
# Both edges read it (nginx and caddy); empty adds none.
EDGE_CLIENT_CSP_SOURCES=

# EDGE_SCHEME is the scheme the public hosts are reached with ("https://" or "http://"). The API's allowed
# admin origin is built from it in every stack. In docker-compose.hub.yml it also drives the caddy edge:
# "https://" for automatic Let's Encrypt certificates (ports 80 and 443 must reach this host), or "http://"
# to serve plain HTTP behind an existing TLS proxy (then pick free ports below). ACME_EMAIL is the
# certificate contact.
EDGE_SCHEME=https://
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
ACME_EMAIL=admin@yourdomain.com

# docker-compose.prod.yml: the application images are ${IMAGE_REGISTRY}/{api,client,admin}:IMAGE_TAG.
# The GitLab deploy jobs export both (IMAGE_REGISTRY from the project's registry path, IMAGE_TAG per tier:
# latest on prod, stage on stage, demo on the demo); a host that builds in place uses any local values.
IMAGE_REGISTRY=registry.example.com/hostpanel
IMAGE_TAG=local
# docker-compose.hub.yml pulls <namespace>/hostpanel:{api,client,admin}-<IMAGE_TAG> (a version without v, or latest).
# docker-compose.hub.yml only: the Docker Hub user/organisation the images are pulled from.
DOCKERHUB_NAMESPACE=innovayse

# ── Third-party images (one definition for every compose file) ───────────────
# Full image references, so a version is bumped here and nowhere else. The infrastructure three are read
# by docker-compose.shared.yml and docker-compose.hub.yml; the mail catcher by the dev and demo stacks;
# the nginx base by docker/nginx/Dockerfile (prod stack); caddy by the hub stack.
# Each is an exact version pinned by digest, so a rebuild never picks up a different image; to upgrade,
# change the tag and its digest together (`docker buildx imagetools inspect <image:tag>` prints the digest).
# NGINX_IMAGE must be the unprivileged nginx build: the edge runs as a non-root user.
POSTGRES_IMAGE=postgres:17.11-alpine3.24@sha256:266d3c257594e195b309ae9d1805e54c788f1d7b375f56bf6c367aac6c917e7b
RABBITMQ_IMAGE=rabbitmq:3.13.7-management-alpine@sha256:606d8c0d6b3c18d1da9afc53bc7cdb2a8d5486df91b5a9830e9e07626c9ae281
REDIS_IMAGE=redis:7.4.12-alpine3.21@sha256:338fbfc036dc5517ac0b04d6de21521085935336e565f223406180e9d84166e2
MAILHOG_IMAGE=mailhog/mailhog:v1.0.1@sha256:8d76a3d4ffa32a3661311944007a415332c4bb855657f4f6c57996405c009bea
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.31.7-alpine3.24@sha256:b5047b9b76845eac124358373c6852377c52e4b05834a47647e955dd91cb8f1e
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d

# ── Dev stack tuning (docker-compose.dev.yml) ────────────────────────────────
# Poll the bind mounts for changes instead of waiting for filesystem events (dotnet watch, webpack, vite).
# Needed on Docker Desktop mounts; the value is the literal true or false.
DEV_FILE_POLLING=true
# NuGet package audit and signature verification inside the dev API container (true or false).
DEV_NUGET_AUDIT=false
DEV_NUGET_SIGNATURE_VERIFICATION=false
# Sign-in passwords of the accounts the development seed creates (DevDataSeed section). They are published
# development fixtures listed in the README, not secrets; the seeder runs in Development only.
DEV_SEED_ADMIN_PASSWORD=Admin123!
DEV_SEED_CLIENT_PASSWORD=Test@12345
# Where Testcontainers finds the Docker host when the integration suite runs inside the dev API container.
TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal
# Base path the admin SPA's dev server calls the API on (proxied to the API by the dev server).
ADMIN_API_BASE=/api

# Resource caps per dev container: CPU count and memory.
DB_CPUS=1.0
DB_MEMORY=1G
RABBITMQ_CPUS=1.0
RABBITMQ_MEMORY=512M
REDIS_CPUS=0.5
REDIS_MEMORY=256M
MAILHOG_CPUS=0.2
MAILHOG_MEMORY=256M
API_CPUS=2.0
API_MEMORY=2G
CLIENT_CPUS=1.5
CLIENT_MEMORY=2G
ADMIN_CPUS=1.0
ADMIN_MEMORY=1536M

# ── Demo (docker-compose.demo.yml) ───────────────────────────────────────────
# Only the demo overlay reads these. Demo mode swaps the payment, registrar and provisioning
# integrations for fakes and sends mail to the demo's own mailhog. It needs AUTH_MODE=local and
# its own POSTGRES_DB. The two passwords have no default: left empty, compose refuses to start. Choose
# them (at least 8 characters with an upper-case and a lower-case letter); they are shown on the sign-in page.
# Reaches the API as Demo__Enabled / Demo__ResetIntervalHours / Demo__*Email / Demo__*Password.
DEMO_ENABLED=true
# How often the demo database is wiped and re-seeded.
DEMO_RESET_INTERVAL_HOURS=24
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=
DEMO_CLIENT_EMAIL=client@demo.local
DEMO_CLIENT_PASSWORD=
# Optional contact the demo storefront shows (footer, contact page) as Demo__ContactEmail / Demo__ContactPhone.
# Empty keeps the seed's fictional demo@hostpanel-demo.example and +1 555 0100. Display only: the demo's mail,
# contact-form mail included, still goes to its own mailhog.
DEMO_CONTACT_EMAIL=
DEMO_CONTACT_PHONE=
# Port of the demo's own mailhog and redis inside the network (the ports those images listen on).
DEMO_SMTP_PORT=1025
DEMO_REDIS_PORT=6379
# Key the demo portal encrypts its stored sessions with: 32 random bytes, base64-encoded, e.g. `openssl rand -base64 32`.
# Use a value of its own, not the production one.
DEMO_SESSION_ENCRYPTION_KEY=
# Address the demo's published ports bind to. Loopback keeps them off the network: the host's edge proxy
# reaches the demo by container name over the dedicated hostpanel_demo_edge network.
DEMO_PUBLISH_ADDRESS=127.0.0.1
# Encryption of the demo's mail catcher: none (it speaks plain SMTP and sends nothing out).
DEMO_SMTP_ENCRYPTION=none
# Host ports the demo publishes (pick ones production and dev do not use).
DEMO_API_HOST_PORT=5150
DEMO_CLIENT_HOST_PORT=3002
DEMO_ADMIN_HOST_PORT=5175
# Absolute URL of the demo admin, the base of the links its mail carries.
DEMO_ADMIN_BASE_URL=http://localhost:5175
# Absolute URL of the demo client portal, the base of the links its mail carries.
DEMO_CLIENT_BASE_URL=http://localhost:3002
DEMO_MAILHOG_UI_HOST_PORT=8028
