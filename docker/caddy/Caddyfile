# Edge of the standalone (Docker Hub) stack: routes the client portal, the admin panel and the API,
# and obtains Let's Encrypt certificates for both hosts on its own. Every value comes from .env
# through docker-compose.hub.yml: {$DOMAIN}, {$ADMIN_DOMAIN}, {$API_PORT}, {$CLIENT_PORT}, {$ACME_EMAIL},
# {$EDGE_MAX_BODY_SIZE}, {$EDGE_ADMIN_MAX_BODY_SIZE}, {$EDGE_SCHEME} ("https://" = automatic HTTPS,
# "http://" = plain HTTP behind an existing proxy) and the optional {$EDGE_CLIENT_CSP_SOURCES}.
{
	email {$ACME_EMAIL}

	servers {
		# A proxy in front (private address) is believed about X-Forwarded-*, so the API sees https
		# there; a direct client is never believed, so it cannot forge the scheme or its address.
		trusted_proxies static private_ranges
	}
}

# Operator-uploaded branding is served on BOTH origins on purpose: the setting rows store
# root-relative URLs, so the same path must mean the same file wherever it is read. nosniff stops a
# browser deciding that a stored file is something executable.
(uploads) {
	handle /uploads/* {
		import security_headers
		# A file opened on its own may load nothing and run nothing.
		header Content-Security-Policy "default-src 'none'; sandbox"
		reverse_proxy hostpanel-api:{$API_PORT}
	}
}

# Response headers every public answer carries. HSTS is ignored by a browser on a plain-HTTP origin, so
# it is harmless in the mode that serves HTTP behind another TLS proxy. Caddy sets (never appends) a
# header, so importing this where the upstream sends the same header cannot duplicate it.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# Default only (the ? prefix): a response that sets its own policy, such as the sign-in callback
		# with no-referrer, keeps it instead of carrying two headers the browser resolves to the looser one.
		?Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()"
	}
}

# Client portal + API
{$EDGE_SCHEME}{$DOMAIN} {
	# Never name the web server in a response.
	header -Server
	import security_headers
	# The portal's own scripts, styles and fonts come from this origin. Nuxt inlines its payload and Vue
	# writes style attributes, hence 'unsafe-inline'. The payment provider's script, frames and API are
	# named, and so are the optional tag manager and analytics. Frames and images are operator content
	# (maps, videos, logos), so any https origin may supply them; a form may post to a payment page on any
	# https origin. EDGE_CLIENT_CSP_SOURCES adds origins a deployment needs (a chat server, other
	# analytics) to the script, connect, frame and image sources.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://www.googletagmanager.com {$EDGE_CLIENT_CSP_SOURCES:}; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https: {$EDGE_CLIENT_CSP_SOURCES:}; connect-src 'self' https://api.stripe.com https://m.stripe.network https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com {$EDGE_CLIENT_CSP_SOURCES:}; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-ancestors 'none'"
	request_body {
		max_size {$EDGE_MAX_BODY_SIZE}
	}

	# Plugin calls may answer with server-sent events: flush every chunk at once instead of buffering.
	# handle takes one matcher, so the two prefixes go through a named path matcher.
	@pluginCalls path /api/client/plugins/* /api/admin/plugins/*
	handle @pluginCalls {
		reverse_proxy hostpanel-api:{$API_PORT} {
			flush_interval -1
			header_up X-Real-IP {client_ip}
			# Replaced, never appended: a value the visitor sent must not reach the client or the API.
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /api/* {
		reverse_proxy hostpanel-api:{$API_PORT} {
			header_up X-Real-IP {client_ip}
			# Replaced, never appended: a value the visitor sent must not reach the client or the API.
			header_up X-Forwarded-For {remote_host}
		}
	}

	import uploads

	# Liveness probe; the API serves it at the root, outside /api/.
	handle /health {
		reverse_proxy hostpanel-api:{$API_PORT}
	}

	# Everything else: Nuxt SSR (WebSocket upgrades are proxied automatically)
	handle {
		reverse_proxy hostpanel-client:{$CLIENT_PORT} {
			header_up X-Real-IP {client_ip}
			# Replaced, never appended: a value the visitor sent must not reach the client or the API.
			header_up X-Forwarded-For {remote_host}
		}
	}
}

# Admin panel. The admin image sends its own security headers and Content-Security-Policy
# (docker/nginx/admin.conf); they pass through untouched.
{$EDGE_SCHEME}{$ADMIN_DOMAIN} {
	# Never name the web server in a response.
	header -Server
	request_body {
		max_size {$EDGE_ADMIN_MAX_BODY_SIZE}
	}

	import uploads

	handle {
		reverse_proxy hostpanel-admin:80 {
			header_up X-Real-IP {client_ip}
		}
	}
}
