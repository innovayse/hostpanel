# Never name the proxy or its version in a response.
server_tokens off;

upstream api_backend {
    server hostpanel-api:${API_PORT};
}

upstream client_frontend {
    server hostpanel-client:${CLIENT_PORT};
}

upstream admin_frontend {
    server hostpanel-admin:80;
}

# Referrer-Policy default for security-headers.conf: empty when the upstream sent its own policy (the
# header is then skipped and the upstream value passes alone), the default otherwise.
map $upstream_http_referrer_policy $referrer_policy {
    ""      "strict-origin-when-cross-origin";
    default "";
}

# TLS ends at the edge, so $scheme is always http here; forward the edge's X-Forwarded-Proto or the API
# refuses sign-in (__Host- cookies need a secure origin).
map $http_x_forwarded_proto $panel_forwarded_proto {
    ""      $scheme;
    default $http_x_forwarded_proto;
}

# The address a request is logged under. A campaign mail's tracking token sits in the path of the open and
# click routes and its unsubscribe token in the query of the unsubscribe page and the one click route; each
# is a credential for one recipient, so the access log keeps the route and drops the token.
map $request_uri $logged_uri {
    default $request_uri;
    "~^(?<track_head>/api/public/campaign-mail/(?:open|click)/)[^/?]+(?<track_tail>.*)$" "$track_head***$track_tail";
    "~^(?<unsub_head>/[^?]*unsubscribe[^?]*[?](?:[^#]*&)?token=)[^&#]*(?<unsub_tail>.*)$" "$unsub_head***$unsub_tail";
}

# The default combined format with $logged_uri in place of the raw request line.
log_format masked '$remote_addr - $remote_user [$time_local] "$request_method $logged_uri $server_protocol" '
                  '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

# X-Forwarded-For is replaced with the connecting address, never appended to: a value the visitor
# sent must not reach the client or the API, which trust the first entry from a known proxy.

# Main site: client + API
server {
    listen 80;
    server_name ${DOMAIN};

    access_log /var/log/nginx/access.log masked;

    client_max_body_size ${EDGE_MAX_BODY_SIZE};

    # Plugin calls may answer with server-sent events: no buffering or caching, a long read timeout,
    # HTTP/1.1 and no Connection close, so events reach the browser as the plugin writes them.
    location ~ ^/api/(client|admin)/plugins/ {
        include snippets/security-headers.conf;
        proxy_pass         http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 1h;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $remote_addr;
        proxy_set_header   X-Forwarded-Proto $panel_forwarded_proto;
    }

    # API requests
    location /api/ {
        include snippets/security-headers.conf;
        proxy_pass         http://api_backend/api/;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $remote_addr;
        proxy_set_header   X-Forwarded-Proto $panel_forwarded_proto;
    }

    include snippets/uploads-location.conf;

    # Liveness probe; the API serves it at the root, outside /api/.
    location = /health {
        include snippets/security-headers.conf;
        proxy_pass         http://api_backend/health;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-Proto $panel_forwarded_proto;
    }

    # The plugin registry reads a confirmation text from here to verify this installation; the API answers it.
    location ^~ /.well-known/hostpanel-registry/ {
        include snippets/security-headers.conf;
        proxy_pass         http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $remote_addr;
        proxy_set_header   X-Forwarded-Proto $panel_forwarded_proto;
    }

    # Everything else: Nuxt SSR
    location / {
        include snippets/security-headers.conf;
        # The portal's own scripts, styles and fonts come from this origin. Nuxt inlines its payload and
        # Vue writes style attributes, hence 'unsafe-inline'. The payment provider's script, frames and
        # API are named; so are the optional tag manager and analytics. Frames and images are
        # operator content (maps, videos, logos), so any https origin may supply them; a form may post to
        # a payment page on any https origin. EDGE_CLIENT_CSP_SOURCES adds origins a deployment needs
        # (a chat server, other analytics) to the script, connect, frame and image sources.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com ${EDGE_CLIENT_CSP_SOURCES}; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https: ${EDGE_CLIENT_CSP_SOURCES}; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com ${EDGE_CLIENT_CSP_SOURCES}; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-ancestors 'none'" always;
        proxy_pass         http://client_frontend;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $remote_addr;
        proxy_set_header   X-Forwarded-Proto $panel_forwarded_proto;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
    }
}

# Admin panel
server {
    listen 80;
    server_name ${ADMIN_DOMAIN};

    client_max_body_size ${EDGE_ADMIN_MAX_BODY_SIZE};

    include snippets/uploads-location.conf;

    # The admin image sends its own security headers and policy (docker/nginx/admin.conf); adding them
    # here as well would send every one twice.
    location / {
        proxy_pass         http://admin_frontend;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $remote_addr;
        proxy_set_header   X-Forwarded-Proto $panel_forwarded_proto;
    }
}
